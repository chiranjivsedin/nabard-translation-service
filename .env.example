# Which translation backend to use: ollama | gemini
TRANSLATOR_BACKEND=ollama

# Common
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000

# Ollama backend (used when TRANSLATOR_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nabard-translator
OLLAMA_TIMEOUT=300

# Gemini backend (used when TRANSLATOR_BACKEND=gemini)
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-2.0-flash
